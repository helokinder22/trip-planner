{
  "name": "TripShare",
  "type": "object",
  "properties": {
    "share_token": {
      "type": "string",
      "description": "Unique token used in the shareable URL"
    },
    "owner_email": {
      "type": "string",
      "description": "Email of the user who created the share"
    }
  },
  "required": [
    "share_token",
    "owner_email"
  ]
}